<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/purple_500"
            app:title="@string/gestures_title" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/gestures_zoom_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gestures_zoom_hint" />

            <ImageView
                android:id="@+id/zoom_image"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/gestures_zoom_image_content_description"
                android:src="@drawable/ic_launcher_foreground" />

            <Button
                android:id="@+id/btn_long_press"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/gestures_long_press" />

            <TextView
                android:id="@+id/gestures_fling_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/gestures_fling_title"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fling_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="8dp" />

            <!-- Spacer content so the screen itself is scrollable (swipe showcase) -->
            <TextView
                android:id="@+id/gestures_spacer"
                android:layout_width="match_parent"
                android:layout_height="1000dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/gestures_title" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
